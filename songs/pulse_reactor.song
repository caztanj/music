[automation]
automate track 4.filter_cutoff from 350 to 3200 over bar 1-16 curve=exponential
automate track 2.filter_cutoff from 350 to 800 over bar 9-16 curve=linear
automate track 6.filter_cutoff from 400 to 7500 over bar 17-32 curve=exponential
automate track 3.filter_cutoff from 1500 to 8000 over bar 33-36 curve=exponential
automate track 2.filter_cutoff from 800 to 300 over bar 49-56 curve=exponential
automate track 4.filter_cutoff from 3200 to 600 over bar 49-56 curve=exponential
automate track 6.filter_cutoff from 400 to 8500 over bar 65-80 curve=exponential
automate track 3.filter_cutoff from 1000 to 9000 over bar 65-80 curve=exponential
automate track 4.filter_cutoff from 3200 to 400 over bar 97-104 curve=exponential
automate master.gain from 0dB to -24dB over bar 101-104 curve=exponential
