[pattern pad_fm]
F2 step=0 len=16 vel=0.70
Ab2 step=0 len=16 vel=0.70
C3 step=0 len=16 vel=0.70
F3 step=0 len=16 vel=0.65

[pattern pad_db]
Db2 step=0 len=16 vel=0.70
F2 step=0 len=16 vel=0.70
Ab2 step=0 len=16 vel=0.70
Db3 step=0 len=16 vel=0.65

[pattern pad_ab]
Ab2 step=0 len=16 vel=0.70
C3 step=0 len=16 vel=0.70
Eb3 step=0 len=16 vel=0.70
Ab3 step=0 len=16 vel=0.65

[pattern pad_eb]
Eb2 step=0 len=16 vel=0.70
G2 step=0 len=16 vel=0.70
Bb2 step=0 len=16 vel=0.70
Eb3 step=0 len=16 vel=0.65

[pattern pluck_fm]
F3 step=0 len=1 vel=0.85
Ab3 step=2 len=1 vel=0.80
C4 step=4 len=1 vel=0.85
Eb4 step=6 len=1 vel=0.90
C4 step=8 len=1 vel=0.80
Ab3 step=10 len=1 vel=0.85
F3 step=12 len=1 vel=0.80
Ab3 step=14 len=1 vel=0.85

[pattern pluck_db]
Db3 step=0 len=1 vel=0.85
F3 step=2 len=1 vel=0.80
Ab3 step=4 len=1 vel=0.85
Db4 step=6 len=1 vel=0.90
Ab3 step=8 len=1 vel=0.80
F3 step=10 len=1 vel=0.85
Db3 step=12 len=1 vel=0.80
F3 step=14 len=1 vel=0.85

[pattern pluck_ab]
Ab2 step=0 len=1 vel=0.85
C3 step=2 len=1 vel=0.80
Eb3 step=4 len=1 vel=0.85
Ab3 step=6 len=1 vel=0.90
Eb3 step=8 len=1 vel=0.80
C3 step=10 len=1 vel=0.85
Ab2 step=12 len=1 vel=0.80
C3 step=14 len=1 vel=0.85

[pattern pluck_eb]
Eb3 step=0 len=1 vel=0.85
G3 step=2 len=1 vel=0.80
Bb3 step=4 len=1 vel=0.85
Eb4 step=6 len=1 vel=0.90
Bb3 step=8 len=1 vel=0.80
G3 step=10 len=1 vel=0.85
Eb3 step=12 len=1 vel=0.80
G3 step=14 len=1 vel=0.85

[pattern lead_hook_1]
F4 step=0 len=3 vel=0.95
C5 step=4 len=3 vel=0.90
Eb5 step=8 len=4 vel=1.00
C5 step=12 len=4 vel=0.90

[pattern lead_hook_2]
Db5 step=0 len=4 vel=0.95
C5 step=4 len=2 vel=0.90
Bb4 step=6 len=2 vel=0.90
Ab4 step=8 len=4 vel=0.95
G4 step=12 len=4 vel=0.85

[pattern lead_hook_3]
Ab4 step=0 len=3 vel=0.90
C5 step=4 len=3 vel=0.90
Eb5 step=8 len=4 vel=1.00
F5 step=12 len=4 vel=1.00

[pattern lead_hook_4]
G5 step=0 len=4 vel=1.00
F5 step=4 len=2 vel=0.95
Eb5 step=6 len=2 vel=0.90
C5 step=8 len=4 vel=0.95
Bb4 step=12 len=4 vel=0.90

[pattern lead_harmony_1]
Ab4 step=0 len=3 vel=0.85
Eb5 step=4 len=3 vel=0.80
G5 step=8 len=4 vel=0.90
Eb5 step=12 len=4 vel=0.85

[pattern lead_harmony_2]
F5 step=0 len=4 vel=0.85
Eb5 step=4 len=2 vel=0.80
Db5 step=6 len=2 vel=0.80
C5 step=8 len=4 vel=0.85
Bb4 step=12 len=4 vel=0.75

[pattern lead_harmony_3]
C5 step=0 len=3 vel=0.80
Eb5 step=4 len=3 vel=0.80
Ab5 step=8 len=4 vel=0.90
Ab5 step=12 len=4 vel=0.90

[pattern lead_harmony_4]
Bb5 step=0 len=4 vel=0.90
Ab5 step=4 len=2 vel=0.85
G5 step=6 len=2 vel=0.80
Eb5 step=8 len=4 vel=0.85
Db5 step=12 len=4 vel=0.80

[mixer]
track 1 (drums): gain = 0.85, pan = 0.0, compressor = on, comp_threshold = -10.0, comp_ratio = 4.0, comp_attack = 4.0, comp_release = 50.0, eq_low = 2.0, eq_low_freq = 80.0, send1 = 0.20, output = master
track 2 (bass): gain = 0.82, pan = 0.0, filter = "lowpass", cutoff = 800, res = 0.25, saturation = "cubic", drive = 1.3, sidechain = track 1, ducking_depth = 14, comp_attack = 1.5, comp_release = 90, output = master
track 3 (lead): gain = 0.70, pan = 0.0, filter = "lowpass", cutoff = 8000, res = 0.25, sidechain = track 1, ducking_depth = 8, comp_attack = 2.0, comp_release = 90, delay = 0.375, feedback = 0.30, send1 = 0.30, output = master
track 4 (pluck): gain = 0.65, pan = -0.15, filter = "lowpass", cutoff = 3200, res = 0.35, delay = 0.25, feedback = 0.30, chorus = 0.30, chorus_rate = 1.1, send1 = 0.20, output = master
track 5 (pad): gain = 0.60, pan = 0.15, filter = "lowpass", cutoff = 2000, res = 0.15, chorus = 0.45, chorus_rate = 0.6, sidechain = track 1, ducking_depth = 10, send1 = 0.45, output = master
track 6 (fx): gain = 0.55, pan = 0.0, filter = "bandpass", cutoff = 3000, res = 0.40, delay = 0.25, feedback = 0.40, send1 = 0.50, output = master
aux 1 (reverb): gain = 0.75, reverb = 0.85, reverb_room = 0.85, reverb_damp = 0.25, reverb_predelay = 15.0
master: gain = 0.95, limiter = on

[channel_routing]
kick -> track 1
clap -> track 1
snare -> track 1
hihat -> track 1
open_hat -> track 1
riser_snare -> track 1
club_bass -> track 2
sub_bass -> track 2
lead -> track 3
lead_harmony -> track 3
pluck -> track 4
pad -> track 5
white_noise -> track 6

