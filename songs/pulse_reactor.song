[project]
name = "Pulse Reactor"
bpm = 128
time_signature = 4/4
bars = 104

[instruments]
kick = sampler("samples/kick.wav", gain = 0.85)
clap = sampler("samples/clap.wav", gain = 0.75)
snare = sampler("samples/snare.wav", gain = 0.70)
hihat = sampler("samples/hihat.wav", attack = 2, decay = 80, choke = 1, gain = 0.55)
open_hat = sampler("samples/hihat.wav", attack = 3, decay = 300, choke = 1, gain = 0.60)
riser_snare = sampler("samples/snare.wav", attack = 4, decay = 120, gain = 0.75)
club_bass = synth(wave="saw", wave2="square", coarse2=-12, osc_mix=0.55, filter="lowpass", cutoff=650, res=0.35, attack=2, decay=130, sustain=0.25, release=60, gain=0.82)
sub_bass = synth(wave="sine", filter="lowpass", cutoff=220, res=0.10, attack=4, decay=180, sustain=0.85, release=80, gain=0.80)
lead = synth(wave="saw", unison=6, detune=24.0, spread=0.90, filter="lowpass", cutoff=3200, res=0.25, attack=8, decay=180, sustain=0.75, release=160, gain=0.65)
lead_harmony = synth(wave="saw", unison=4, detune=18.0, spread=0.80, filter="lowpass", cutoff=2800, res=0.25, attack=8, decay=180, sustain=0.70, release=160, gain=0.60)
pluck = synth(wave="square", filter="lowpass", cutoff=2000, res=0.45, attack=2, decay=90, sustain=0.15, release=70, gain=0.65)
pad = synth(wave="saw", wave2="saw", tune2=8.0, osc_mix=0.50, filter="lowpass", cutoff=1200, res=0.18, attack=150, decay=350, sustain=0.85, release=450, gain=0.60)
white_noise = synth(wave="white", filter="bandpass", cutoff=2500, res=0.40, attack=50, decay=200, sustain=0.80, release=250, gain=0.30)

[pattern drum_kick_only]
kick     | x . . . x . . . x . . . x . . . |

[pattern drum_kick_hat]
kick     | x . . . x . . . x . . . x . . . |
open_hat | . . x . . . x . . . x . . . x . |

[pattern drum_drop]
kick     | x . . . x . . . x . . . x . . . |
clap     | . . . . x . . . . . . . x . . . |
snare    | . . . . x . . . . . . . x . . . |
open_hat | . . x . . . x . . . x . . . x . |
hihat    | x . x . x . x . x . x . x . x . |

[pattern drum_drop_heavy]
kick     | x . . . x . . . x . . . x . . . |
clap     | . . . . x . . . . . . . x . . . |
snare    | . . . . x . . . . . . . x . . . |
open_hat | . . x . . . x . . . x . . . x . |
hihat    | x x x x x x x x x x x x x x x x |

[pattern riser_stage_1]
snare    | x . . . x . . . x . . . x . . . |
hihat    | x . x . x . x . x . x . x . x . |

[pattern riser_stage_2]
snare    | x . x . x . x . x . x . x . x . |
clap     | . . . . x . . . . . . . x . . . |
hihat    | x x x x x x x x x x x x x x x x |

[pattern riser_stage_3]
snare       | x x x x x x x x x x x x x x x x |
riser_snare | . x . x . x . x . x . x . x . x |
clap        | . . . . x . . . . . . . x . . . |

[pattern riser_stage_4]
snare       | x x x x x x x x x x x x . . . . |
riser_snare | x x x x x x x x x x x x . . . . |
clap        | x . x . x . x . x . x . . . . . |

[pattern noise_sweep]
C4 step=0 len=16 vel=0.75

[pattern bass_rolling_fm]
F1 step=0 len=1 vel=0.95
F1 step=1 len=1 vel=0.75
F2 step=2 len=1 vel=0.85
F1 step=3 len=1 vel=0.75
F1 step=4 len=1 vel=0.90
F1 step=5 len=1 vel=0.75
