[project]
name           = "Synth Lead"
bpm            = 124
time_signature = 4/4
bars           = 8

[instruments]
lead = synth(wave="saw", filter="lowpass", cutoff=1600, res=0.3, attack=10, decay=80, sustain=0.5, release=150)
bass = synth(wave="square", filter="lowpass", cutoff=800, res=0.1, attack=5, decay=50, sustain=0.7, release=80)

[pattern melody]
C4   step=0   len=2  vel=0.85
Eb4  step=4   len=2  vel=0.80
G4   step=8   len=4  vel=0.90
Bb4  step=12  len=4  vel=0.95

[pattern bassline]
C2   step=0   len=4  vel=0.90
G2   step=4   len=4  vel=0.85
Ab2  step=8   len=4  vel=0.85
Bb2  step=12  len=4  vel=0.90

[mixer]
track 1 (lead): gain = 0.8, pan = 0.0, delay = 0.2, feedback = 0.3, output = master
track 2 (bass): gain = 0.9, pan = 0.0, output = master
master:         gain = 1.0, limiter = on, ceiling = -0.1db

[channel_routing]
lead -> track 1
bass -> track 2

[arrangement]
bar 1-8: melody
bar 1-8: bassline
