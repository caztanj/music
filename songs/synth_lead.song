[project]
name = "Neon Arp"
bpm = 130
time_signature = 4/4
bars = 4

[instruments]
lead = synth(wave="saw", filter="lowpass", cutoff=2200, res=0.3, attack=8, decay=80, sustain=0.4, release=150, gain=0.85)

[pattern lead_melody]
C4 step=0 len=2 vel=0.9
Eb4 step=2 len=2 vel=0.8
G4 step=4 len=2 vel=0.85
Bb4 step=6 len=2 vel=0.8
C5 step=8 len=2 vel=0.95
Bb4 step=10 len=2 vel=0.85
G4 step=12 len=2 vel=0.8
F4 step=14 len=2 vel=0.75

[mixer]
track 1 (lead): gain = 0.85, pan = 0.1, delay = 0.23, feedback = 0.35, output = master
master: gain = 1.0, limiter = on

[channel_routing]
lead -> track 1

[arrangement]
bar 1-4: lead_melody
