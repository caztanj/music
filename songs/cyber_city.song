[automation]
automate track 4.filter_cutoff from 350 to 3000 over bar 1-16 curve=exponential
automate track 2.filter_cutoff from 400 to 1800 over bar 17-24 curve=linear
automate track 3.filter_cutoff from 2000 to 8000 over bar 33-36 curve=exponential
automate track 2.filter_cutoff from 2000 to 350 over bar 49-56 curve=exponential
automate track 4.filter_cutoff from 3000 to 500 over bar 49-56 curve=exponential
automate track 4.filter_cutoff from 500 to 6000 over bar 65-72 curve=exponential
automate track 3.filter_cutoff from 500 to 9000 over bar 65-72 curve=exponential
automate master.gain from 0dB to -24dB over bar 93-96 curve=exponential
