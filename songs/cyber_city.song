Bb0 step=9 len=1 vel=0.75
Bb1 step=10 len=1 vel=0.85
Bb0 step=11 len=1 vel=0.75
F1 step=12 len=1 vel=0.90
A1 step=13 len=1 vel=0.80
Bb1 step=14 len=1 vel=0.85
Bb0 step=15 len=1 vel=0.75

[pattern pad_chords_cm]
C3 step=0 len=16 vel=0.75
Eb3 step=0 len=16 vel=0.75
G3 step=0 len=16 vel=0.75
C4 step=0 len=16 vel=0.70

[pattern pad_chords_ab]
Ab2 step=0 len=16 vel=0.75
C3 step=0 len=16 vel=0.75
Eb3 step=0 len=16 vel=0.75
Ab3 step=0 len=16 vel=0.70

[pattern pad_chords_eb]
Eb3 step=0 len=16 vel=0.75
G3 step=0 len=16 vel=0.75
Bb3 step=0 len=16 vel=0.75
Eb4 step=0 len=16 vel=0.70

[pattern pad_chords_bb]
Bb2 step=0 len=16 vel=0.75
D3 step=0 len=16 vel=0.75
F3 step=0 len=16 vel=0.75
Bb3 step=0 len=16 vel=0.70

[pattern arp_cm]
C3 step=0 len=1 vel=0.85
Eb3 step=2 len=1 vel=0.80
G3 step=4 len=1 vel=0.85
C4 step=6 len=1 vel=0.90
G3 step=8 len=1 vel=0.80
Eb3 step=10 len=1 vel=0.85
C3 step=12 len=1 vel=0.80
Eb3 step=14 len=1 vel=0.85

[pattern arp_ab]
Ab2 step=0 len=1 vel=0.85
C3 step=2 len=1 vel=0.80
Eb3 step=4 len=1 vel=0.85
Ab3 step=6 len=1 vel=0.90
Eb3 step=8 len=1 vel=0.80
C3 step=10 len=1 vel=0.85
Ab2 step=12 len=1 vel=0.80
C3 step=14 len=1 vel=0.85

[pattern arp_eb]
Eb3 step=0 len=1 vel=0.85
G3 step=2 len=1 vel=0.80
Bb3 step=4 len=1 vel=0.85
Eb4 step=6 len=1 vel=0.90
Bb3 step=8 len=1 vel=0.80
G3 step=10 len=1 vel=0.85
Eb3 step=12 len=1 vel=0.80
G3 step=14 len=1 vel=0.85

[pattern arp_bb]
Bb2 step=0 len=1 vel=0.85
D3 step=2 len=1 vel=0.80
F3 step=4 len=1 vel=0.85
Bb3 step=6 len=1 vel=0.90
F3 step=8 len=1 vel=0.80
D3 step=10 len=1 vel=0.85
Bb2 step=12 len=1 vel=0.80
D3 step=14 len=1 vel=0.85

[pattern lead_hook_1]
C4 step=0 len=3 vel=0.90
G4 step=4 len=3 vel=0.85
Bb4 step=8 len=4 vel=0.95
G4 step=12 len=4 vel=0.85

[pattern lead_hook_2]
Ab4 step=0 len=4 vel=0.90
G4 step=4 len=2 vel=0.85
F4 step=6 len=2 vel=0.85
Eb4 step=8 len=4 vel=0.90
D4 step=12 len=4 vel=0.80

[pattern lead_hook_3]
Eb4 step=0 len=3 vel=0.85
G4 step=4 len=3 vel=0.85
Bb4 step=8 len=4 vel=0.95
C5 step=12 len=4 vel=1.00

[pattern lead_hook_4]
D5 step=0 len=4 vel=0.95
C5 step=4 len=2 vel=0.90
Bb4 step=6 len=2 vel=0.85
G4 step=8 len=4 vel=0.90
F4 step=12 len=4 vel=0.85

[pattern lead_harmony_1]
Eb4 step=0 len=3 vel=0.80
Bb4 step=4 len=3 vel=0.80
D5 step=8 len=4 vel=0.85
Bb4 step=12 len=4 vel=0.80

[pattern lead_harmony_2]
C5 step=0 len=4 vel=0.85
Bb4 step=4 len=2 vel=0.80
Ab4 step=6 len=2 vel=0.80
G4 step=8 len=4 vel=0.85
F4 step=12 len=4 vel=0.75

[pattern lead_harmony_3]
G4 step=0 len=3 vel=0.80
Bb4 step=4 len=3 vel=0.80
Eb5 step=8 len=4 vel=0.90
Eb5 step=12 len=4 vel=0.90

[pattern lead_harmony_4]
F5 step=0 len=4 vel=0.90
Eb5 step=4 len=2 vel=0.85
D5 step=6 len=2 vel=0.80
Bb4 step=8 len=4 vel=0.85
Ab4 step=12 len=4 vel=0.80

[mixer]
track 1 (drums): gain = 0.85, pan = 0.0, output = master, send1 = 0.25
track 2 (bass): gain = 0.80, pan = 0.0, filter = "lowpass", cutoff = 800, res = 0.2, sidechain = track 1, ducking_depth = 12, comp_attack = 2, comp_release = 120, output = master
track 3 (lead): gain = 0.70, pan = 0.0, filter = "lowpass", cutoff = 8000, res = 0.25, delay = 0.25, feedback = 0.35, send1 = 0.25, output = master
track 4 (arp): gain = 0.65, pan = -0.15, filter = "lowpass", cutoff = 3000, res = 0.3, delay = 0.375, feedback = 0.3, chorus = 0.35, chorus_rate = 1.0, send1 = 0.20, output = master
track 5 (pad): gain = 0.60, pan = 0.15, filter = "lowpass", cutoff = 2500, res = 0.15, chorus = 0.4, chorus_rate = 0.8, send1 = 0.35, output = master
aux 1 (reverb): gain = 0.70, reverb = 0.85, reverb_room = 0.8, reverb_damp = 0.3, reverb_predelay = 20.0
master: gain = 0.95, limiter = on

[channel_routing]
kick -> track 1
snare -> track 1
hihat -> track 1
clap -> track 1
bass -> track 2
lead -> track 3
arp -> track 4
pad -> track 5

