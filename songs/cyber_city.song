[project]
name = "Cyber City"
bpm = 120
time_signature = 4/4
bars = 96
swing = 0.05

[instruments]
kick = sampler("samples/kick.wav", gain = 0.85)
snare = sampler("samples/snare.wav", gain = 0.75)
hihat = sampler("samples/hihat.wav", gain = 0.55)
clap = sampler("samples/clap.wav", gain = 0.65)
bass = synth(wave="saw", wave2="square", coarse2=-12, osc_mix=0.6, filter="lowpass", cutoff=650, res=0.25, attack=3, decay=120, sustain=0.4, release=80, gain=0.82)
lead = synth(wave="saw", unison=6, detune=22.0, spread=0.85, filter="lowpass", cutoff=2800, res=0.25, attack=12, decay=180, sustain=0.7, release=220, gain=0.60)
arp = synth(wave="saw", filter="lowpass", cutoff=1400, res=0.35, attack=5, decay=90, sustain=0.3, release=100, gain=0.65)
pad = synth(wave="saw", wave2="saw", tune2=8.0, osc_mix=0.5, filter="lowpass", cutoff=1100, res=0.15, attack=180, decay=350, sustain=0.8, release=450, gain=0.60)

[pattern drum_intro]
kick  | x . . . . . . . x . . . . . . . |
hihat | . . x . . . x . . . x . . . x . |

[pattern drum_verse]
kick  | x . . . x . . . x . . . x . . . |
snare | . . . . x . . . . . . . x . . . |
hihat | x . x . x . x . x . x . x . x . |

[pattern drum_chorus]
kick  | x . . . x . . . x . . . x . . . |
snare | . . . . x . . . . . . . x . . . |
clap  | . . . . x . . . . . . . x . . . |
hihat | x x x x x x x x x x x x x x x x |

[pattern drum_build]
snare | x . x . x . x . x x x x x x x x |
clap  | . . . . . . . . . . x . . . x . |
hihat | x . x . x . x . x . x . x . x . |

[pattern drum_outro]
kick  | x . . . . . . . x . . . . . . . |
hihat | x . . . x . . . x . . . x . . . |

[pattern bass_intro]
C2 step=0 len=8 vel=0.8
C2 step=8 len=8 vel=0.75

[pattern bass_drive_cm]
C1 step=0 len=1 vel=0.95
C1 step=1 len=1 vel=0.75
C2 step=2 len=1 vel=0.85
C1 step=3 len=1 vel=0.75
C1 step=4 len=1 vel=0.90
C1 step=5 len=1 vel=0.75
