Eb1 step=9 len=1 vel=0.75
Eb2 step=10 len=1 vel=0.85
Eb1 step=11 len=1 vel=0.75
Bb1 step=12 len=1 vel=0.90
D2 step=13 len=1 vel=0.80
Eb2 step=14 len=1 vel=0.85
Eb1 step=15 len=1 vel=0.75

[pattern bass_drive_bb]
Bb0 step=0 len=1 vel=0.95
Bb0 step=1 len=1 vel=0.75
Bb1 step=2 len=1 vel=0.85
Bb0 step=3 len=1 vel=0.75
Bb0 step=4 len=1 vel=0.90
Bb0 step=5 len=1 vel=0.75
