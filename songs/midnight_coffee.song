[automation]
automate track 3.filter_cutoff from 800 to 2200 over bar 1-8 curve=exponential
automate track 1.filter_cutoff from 500 to 9000 over bar 5-8 curve=linear
automate track 4.filter_cutoff from 1200 to 3000 over bar 17-24 curve=exponential
automate track 3.filter_cutoff from 2200 to 900 over bar 41-44 curve=exponential
automate track 3.filter_cutoff from 900 to 2400 over bar 45-48 curve=exponential
automate track 4.filter_cutoff from 2400 to 1000 over bar 53-56 curve=exponential
automate master.gain from 0dB to -24dB over bar 61-64 curve=exponential
